{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "openfable-zcode-rebuild",
  "version": "0.2.0-final",
  "description": "ZCode-aligned rebuild of OpenFable — agent harness, swarm federation, AgentDB memory, plugin marketplace, full file access",
  "type": "module",
  "scripts": {
    "typecheck": "bun run tsgo --noEmit",
    "lint": "oxlint",
    "build:android": "cd ../android && ./gradlew assembleRelease",
    "build:desktop": "cd ../packages/desktop && bun run build"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.48",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}